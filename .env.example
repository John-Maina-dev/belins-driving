# Django Core Settings
DJANGO_SETTINGS_MODULE=driving_school.settings.dev
SECRET_KEY=change-me-to-a-secure-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave DATABASE_URL empty or unset to default to SQLite in development,
# or specify PostgreSQL connection string: postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3
# Alternatively separate DB settings if not using DATABASE_URL:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# M-Pesa Daraja API Settings
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=your_mpesa_initiator_password_here
MPESA_CALLBACK_URL=https://yourdomain.com/payments/mpesa/callback/

# SMS Gateway Settings (e.g. Africa's Talking)
SMS_PROVIDER=africastalking
SMS_USERNAME=sandbox
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=

